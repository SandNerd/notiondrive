{
  "name": "notiondrive",
  "version": "0.1.4",
  "description": "Download your Notion content to local Markdown files. Beautiful CLI, clean output, ready for AI agents.",
  "type": "module",
  "bin": {
    "notiondrive": "bin/cli.js"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "keywords": [
    "notion",
    "markdown",
    "export",
    "cli",
    "notion-to-markdown",
    "notion-export",
    "notiondrive",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/neethanwu/notiondrive"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "validate-config": "node scripts/validate-config.js ./notiondrive.config.json",
    "qualify:rigour": "node scripts/rigour-qualification.js",
    "rigour": "rigour"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@notionhq/client": "^2.2.15",
    "notion-to-md": "^3.1.9"
  },
  "devDependencies": {
    "@rigour-labs/cli": "7.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1"
  }
}
